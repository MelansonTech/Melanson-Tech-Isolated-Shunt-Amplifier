       "2": {"label": "AIP", "driver": "shunt", "dir": "in", "role": "non-inverting input through R1", "must_reach": ["R1", "1"]},
       "3": {"label": "AIN", "driver": "shunt", "dir": "in", "role": "inverting input through R12", "must_reach": ["R12", "1"]},
       "4": {"label": "GNDA", "driver": "PSU1", "dir": "in", "role": "isolated ground", "must_reach": ["PSU1", "7"]},
       "5": {"label": "GNDB", "driver": "GND", "dir": "in", "role": "output-side ground", "must_reach": ["U6", "1"]},
       "6": {"label": "AON", "driver": "U2", "dir": "out", "role": "inverted output into R9", "must_reach": ["R9", "2"]},
       "7": {"label": "AOP", "driver": "U2", "dir": "out", "role": "output into R2", "must_reach": ["R2", "2"]},
       "8": {"label": "VDDB", "driver": "+5", "dir": "in", "role": "output-side supply from U6", "must_reach": ["U6", "3"]}
     }},
    {"name": "PSU1 NXJ1S0505 isolated DC-DC", "connector": "PSU1",
     "pins": {
       "3": {"label": "+Vin", "driver": "+5 through L2", "dir": "in", "role": "module input", "must_reach": ["L2", "1"]},
       "1": {"label": "-Vin", "driver": "GND", "dir": "in", "role": "module input return", "must_reach": ["U6", "1"]},
       "8": {"label": "+Vout", "driver": "PSU1", "dir": "out", "role": "isolated 5 V into L3", "must_reach": ["L3", "2"]},
       "7": {"label": "-Vout", "driver": "PSU1", "dir": "out", "role": "isolated ground", "must_reach": ["R6", "1"]}
     }},
    {"name": "U1 UA78L12 (SOT-89: 1 OUT, 2 GND, 3 IN)", "connector": "U1",
     "pins": {
       "3": {"label": "IN", "driver": "VregIn", "dir": "in", "role": "from the switch", "must_reach": ["SW1", "3"]},
       "1": {"label": "OUT", "driver": "U1", "dir": "out", "role": "+12 rail", "must_reach": ["C33", "2"]},
       "2": {"label": "GND", "driver": "GND", "dir": "in", "role": "ground", "must_reach": ["C32", "1"]}
     }},
    {"name": "U6 HT7550-1 (SOT-89: 1 GND, 2 VIN, 3 VOUT)", "connector": "U6",
     "pins": {
       "2": {"label": "VIN", "driver": "VregIn", "dir": "in", "role": "from the switch", "must_reach": ["SW1", "3"]},
       "3": {"label": "VOUT", "driver": "U6", "dir": "out", "role": "+5 rail into L2 and the Si8921", "must_reach": ["L2", "2"]},
       "1": {"label": "GND", "driver": "GND", "dir": "in", "role": "ground", "must_reach": ["C5", "1"]}
     }}
  ]
}
