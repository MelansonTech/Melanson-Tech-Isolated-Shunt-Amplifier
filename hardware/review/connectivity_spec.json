{
  "_comment": "Each pin's role at the device that drives it, and the target pin it must reach. Pin functions of SW1, J4, Rel1, U2, PSU1, U1 and U6 are checked against their datasheets in datasheet_checks.py; this file carries the design intent.",
  "interfaces": [
    {"name": "J4 auxiliary supply, PJ-002A, driven by the external 13-15 V adapter", "connector": "J4",
     "pins": {
       "1": {"label": "centre pin", "driver": "adapter +", "dir": "out", "role": "V+ into the CM choke", "must_reach": ["CM1", "1"]},
       "2": {"label": "sleeve", "driver": "adapter -", "dir": "out", "role": "0 V return into the CM choke", "must_reach": ["CM1", "3"]},
       "3": {"label": "tip switch, rests on the sleeve", "driver": "adapter -", "dir": "out", "role": "0 V return", "must_reach": ["CM1", "3"]}
     }},
    {"name": "J1 signal output, SMA 142-0701-801, read by a 1 Mohm instrument", "connector": "J1",
     "pins": {
       "1": {"label": "centre", "driver": "instrument input", "dir": "in", "role": "IsenseOut after the 50 ohm", "must_reach": ["R4", "1"]},
       "S1": {"label": "shell", "driver": "instrument ground", "dir": "in", "role": "ISenseRTN, the chassis reference", "must_reach": ["U5", "1"]},
       "S2": {"label": "shell", "driver": "instrument ground", "dir": "in", "role": "ISenseRTN", "must_reach": ["U5", "1"]},
       "S3": {"label": "shell", "driver": "instrument ground", "dir": "in", "role": "ISenseRTN", "must_reach": ["U5", "1"]},
       "S4": {"label": "shell", "driver": "instrument ground", "dir": "in", "role": "ISenseRTN", "must_reach": ["U5", "1"]}
     }},
    {"name": "J2 current input, Phoenix 5442002, the measured circuit (CONNECTORS.md: pin 2 high side)", "connector": "J2",
     "pins": {
       "2": {"label": "high side", "driver": "measured circuit", "dir": "out", "role": "current enters the shunt at terminal 1", "must_reach": ["R5", "1"]},
       "1": {"label": "low side", "driver": "measured circuit", "dir": "in", "role": "current leaves the shunt at terminal 2", "must_reach": ["R5", "2"]}
     }},
    {"name": "R5 shunt WSL3637 Kelvin terminals into the Si8921", "connector": "R5",
     "pins": {
       "4": {"label": "sense at terminal 1", "driver": "shunt", "dir": "out", "role": "AIP side, the isolated ground reference", "must_reach": ["R1", "2"]},
       "3": {"label": "sense at terminal 2", "driver": "shunt", "dir": "out", "role": "AIN side through R12", "must_reach": ["R12", "2"]}
     }},
    {"name": "SW1 range and off switch, C&K OS103011, operated by the user", "connector": "SW1",
     "pins": {
       "2": {"label": "pole", "driver": "switch", "dir": "in", "role": "fed from Vin through D3", "must_reach": ["D3", "1"]},
       "3": {"label": "position 2 (x10)", "driver": "switch", "dir": "out", "role": "VregIn to the 12 V regulator input", "must_reach": ["U1", "3"]},
       "4": {"label": "position 3 (x100)", "driver": "switch", "dir": "out", "role": "HighGain to the relay coil", "must_reach": ["Rel1", "5"]},
       "5": {"label": "frame", "driver": "switch", "dir": "in", "role": "board 0 V", "must_reach": ["U1", "2"]},
       "6": {"label": "frame", "driver": "switch", "dir": "in", "role": "board 0 V", "must_reach": ["U1", "2"]}
     }},
    {"name": "R28 zero trimmer CT94, adjusted by the user", "connector": "R28",
     "pins": {
       "1": {"label": "end 1", "driver": "trimmer", "dir": "in", "role": "ground-side divider leg R29", "must_reach": ["R29", "2"]},
       "3": {"label": "end 3", "driver": "trimmer", "dir": "in", "role": "+12-side divider leg R26", "must_reach": ["R26", "1"]},
       "2": {"label": "wiper", "driver": "trimmer", "dir": "out", "role": "OffsetAdj through R21 (board end 1; the sheet has R21 the other way round)", "must_reach": ["R21", "1"]}
     }},
    {"name": "Rel1 range relay G6L-1F DC12", "connector": "Rel1",
     "pins": {
       "5": {"label": "coil", "driver": "HighGain", "dir": "in", "role": "coil drive from the switch", "must_reach": ["SW1", "4"]},
       "8": {"label": "coil", "driver": "GND", "dir": "in", "role": "coil return", "must_reach": ["U1", "2"]},
       "4": {"label": "contact", "driver": "ISenseRTN", "dir": "in", "role": "gain-set leg to the reference", "must_reach": ["U5", "1"]},
       "2": {"label": "contact", "driver": "R14/R16/R18", "dir": "in", "role": "gain-set leg to the U8 inverting network", "must_reach": ["R14", "2"]}
     }},
    {"name": "U2 Si8921 isolated amplifier", "connector": "U2",
